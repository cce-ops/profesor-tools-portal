---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Herramientas Proyectos Ingeniería',
  description = 'Portal con enlaces a todas las aplicaciones y herramientas del curso de Proyectos de Ingeniería.',
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafafa;
    --fg: #1a1a1a;
    --card-bg: #ffffff;
    --border: #e5e5e5;
    --accent: #2563eb;
    --accent-hover: #1d4ed8;
    --muted: #737373;
    --radius: 12px;
    --gap: 1.5rem;
    --max-width: 960px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0a0a0a;
      --fg: #fafafa;
      --card-bg: #171717;
      --border: #262626;
      --accent: #60a5fa;
      --accent-hover: #93c5fd;
      --muted: #a3a3a3;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family:
      system-ui, -apple-system, 'Segoe UI', Roboto, Ubuntu, Cantarell,
      'Helvetica Neue', Arial, sans-serif;
    line-height: 1.6;
    min-height: 100vh;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  a {
    color: var(--accent);
  }
</style>

<style>
  body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1rem 3rem;
  }
</style>
