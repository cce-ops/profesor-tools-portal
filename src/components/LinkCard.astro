---
import type { Link } from '../data/schema';

interface Props {
  link: Link;
}

const { link } = Astro.props;
---
<article class="link-card">
  <h3>{link.name}</h3>
  {link.description && <p class="desc">{link.description}</p>}
  {link.tags && link.tags.length > 0 && (
    <div class="tags">
      {link.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  )}
  <a class="btn" href={link.url} target="_blank" rel="noopener noreferrer">
    Abrir →
  </a>
</article>

<style>
  .link-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .link-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .link-card h3 {
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .desc {
    color: var(--muted);
    font-size: 0.92rem;
    flex-grow: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
  }

  .btn {
    display: inline-block;
    text-align: center;
    text-decoration: none;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
    border-radius: 8px;
    padding: 0.55rem 1rem;
    margin-top: 0.25rem;
  }

  .btn:hover {
    background: var(--accent-hover);
  }

  @media (prefers-color-scheme: dark) {
    .btn {
      color: #0a0a0a;
    }
  }
</style>
